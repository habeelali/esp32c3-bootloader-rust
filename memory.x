MEMORY
{
    /* ESP32-C3 IRAM: 0x4037C000 - 0x403E0000 (400KB) */
    /* Bootloader uses first portion of IRAM */
    IRAM : ORIGIN = 0x4037C000, LENGTH = 0x8000
    /* DRAM: 0x3FC80000 - 0x3FCE0000 (384KB) */
    DRAM : ORIGIN = 0x3FC80000, LENGTH = 0x8000
}

REGION_ALIAS("REGION_TEXT", IRAM);
REGION_ALIAS("REGION_RODATA", IRAM);
REGION_ALIAS("REGION_DATA", DRAM);
REGION_ALIAS("REGION_BSS", DRAM);
REGION_ALIAS("REGION_HEAP", DRAM);
REGION_ALIAS("REGION_STACK", DRAM);

_stack_start = ORIGIN(DRAM) + LENGTH(DRAM);
